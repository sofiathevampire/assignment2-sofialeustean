<%- include("templates/header") %>

<div class="container text-center">

  <% if (!loggedIn) { %>

    <h1>Welcome</h1>

    <a href="/signup" class="btn btn-primary btn-lg my-2">Sign Up</a>
    <a href="/login" class="btn btn-secondary btn-lg my-2">Log In</a>

  <% } else { %>

    <h1>Hello, <%= name %>!</h1>

    <a href="/members" class="btn btn-primary btn-lg my-2">Go to Members Area</a>
    <a href="/logout" class="btn btn-danger btn-lg my-2">Logout</a>

  <% } %>

</div>

<%- include("templates/footer") %>
